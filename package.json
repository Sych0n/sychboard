{
  "name": "sychboard",
  "version": "1.0.16",
  "description": "SychBoard - Your personal AI dashboard",
  "main": "main.js",
  "author": {
    "name": "Sych0n",
    "email": "danieltcpires@gmail.com"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build-portable": "electron-builder --win portable --x64",
    "publish": "electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "com.sychboard.app",
    "productName": "SychBoard",
    "copyright": "Copyright © 2026 Sych0n",
    "icon": "assets/icon",
    "publish": {
      "provider": "github",
      "owner": "Sych0n",
      "repo": "sychboard",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SychBoard"
    },
    "files": [
      "main.js",
      "preload.js",
      "mcp-client.js",
      "src/**/*",
      "assets/**/*",
      "sychboard-mcp/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "sychboard-mcp/commit-dialog.ps1"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "playwright-core": "^1.61.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.3"
  }
}
